{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/dom-utils",
  "version": "0.0.3",
  "description": "Typed DOM helpers for building vanilla JavaScript and TypeScript interfaces with native elements and inline cssText styling.",
  "keywords": [
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsdown && typedoc",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "build:browser": "node in-browser-testing-build.js && prettier index.js --write",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "test": "npm run build && npm run typecheck && npm run test:e2e",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/dom-utils.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/dom-utils/issues"
  },
  "homepage": "https://sovereignbase.dev/dom-utils",
  "dependencies": {
    "bowser": "^2.15.0"
  }
}
