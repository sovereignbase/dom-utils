{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/dom-utils",
  "version": "0.0.3",
  "description": "Typed DOM helpers for building vanilla JavaScript and TypeScript interfaces with native elements and inline cssText styling.",
  "keywords": [
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "tsdown && typedoc",
    "build:browser": "node in-browser-testing-build.js",
    "prepare": "husky"
  },
  "c8": {
    "all": true,
    "include": [
      "dist/**/*.js"
    ],
    "exclude": [
      "dist/**/*.d.ts",
      "test/**",
      "benchmark/**",
      "playwright.config.ts"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/dom-utils.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/dom-utils/issues"
  },
  "homepage": "https://sovereignbase.dev/dom-utils"
}
